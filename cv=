function Header({ name, jobTitle }) {
  return (
    <header style={{ textAlign: "center", borderBottom: "2px solid #ccc", paddingBottom: "10px" }}>
      <h1>{name}</h1>
      <h3>{jobTitle}</h3>
    </header>
  );
}
function Section({ title, children }) {
  return (
    <section style={{ margin: "20px 0" }}>
      <h2 style={{ color: "#2c3e50", borderBottom: "1px solid #eee", paddingBottom: "5px" }}>
        {title}
      </h2>
      <div className="section-content">
        {children}
      </div>
    </section>
  );
}
function ListItem({ title, description }) {
  return (
    <li style={{ marginBottom: "8px", lineHeight: "1.5" }}>
      <strong>{title}</strong> {description && `- ${description}`}
    </li>
  );
}

export default function CVPage() 
  const skillsData = [
